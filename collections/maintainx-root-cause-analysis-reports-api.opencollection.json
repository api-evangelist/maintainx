{
  "opencollection": "1.0.0",
  "info": {
    "name": "MaintainX Asset Criticalities Root Cause Analysis Reports API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Root Cause Analysis Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List root cause analysis reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/rootcauseanalysisreports",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "assets",
                "value": "",
                "type": "query"
              },
              {
                "name": "statuses",
                "value": "",
                "type": "query"
              },
              {
                "name": "creators",
                "value": "",
                "type": "query"
              },
              {
                "name": "archived",
                "value": "",
                "type": "query"
              },
              {
                "name": "createdAfter",
                "value": "",
                "type": "query"
              },
              {
                "name": "createdBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Endpoint used to list root cause analysis report resources"
        },
        {
          "info": {
            "name": "Get root cause analysis report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/rootcauseanalysisreports/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the rootCauseAnalysisReport"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get root cause analysis report"
        }
      ]
    }
  ],
  "bundled": true
}