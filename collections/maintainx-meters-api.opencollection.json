{
  "opencollection": "1.0.0",
  "info": {
    "name": "MaintainX Asset Criticalities Meters API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List meters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/meters",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "measurementType",
                "value": "",
                "type": "query"
              },
              {
                "name": "assets",
                "value": "",
                "type": "query"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Endpoint used to list meter resources"
        },
        {
          "info": {
            "name": "Create new meter",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getmaintainx.com/v1/meters",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Endpoint used to create a new meter. Pay attention to the `measurementType` field as it has a significant impact on the behavior of your meter."
        },
        {
          "info": {
            "name": "Get meter",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/meters/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the meter"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get meter"
        },
        {
          "info": {
            "name": "Update meter",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.getmaintainx.com/v1/meters/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the meter"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update meter"
        },
        {
          "info": {
            "name": "Delete meter",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getmaintainx.com/v1/meters/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the meter"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ]
          },
          "docs": "Delete meter"
        },
        {
          "info": {
            "name": "Create new meter reading",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getmaintainx.com/v1/meters/:meterId/readings",
            "params": [
              {
                "name": "meterId",
                "value": "123",
                "type": "path",
                "description": "ID of the meter"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "We strongly recommend using the batch create endpoint [POST /meterreadings](#tag/Meter-Readings/paths/~1meterreadings/post) to create meter readings since it is more efficient and allows you to send more readings at once without consuming as much rate limit as this endpoint.\n      <h3>Rate Limits</h3>\n      <li>For Automated and IoT meter readings: 1 request / 10 seconds</li>\n      <li>For Manual meter readings: 10 requests / 24 hours</li>\n      "
        }
      ]
    }
  ],
  "bundled": true
}