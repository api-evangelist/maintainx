              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"meterId\": \"<number>\",\n    \"value\": \"<number>\",\n    \"readingDate\": \"<string>\"\n  },\n  {\n    \"meterId\": \"<number>\",\n    \"value\": \"<number>\",\n    \"readingDate\": \"<string>\"\n  }\n]",
