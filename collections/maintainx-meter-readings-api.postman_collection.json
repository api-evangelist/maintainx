          "name": "Batch create new meter readings",
          "request": {
            "name": "Batch create new meter readings",
            "description": {
              "content": "We strongly recommend using this endpoint to create meter readings since it is more efficient.\n      <h3>Rate Limits</h3>\n      <li>For Automated and IoT meter readings: 100 requests / 60 seconds</li>\n      <li>For Manual meter readings: 10 requests / 24 hours</li>\n      ",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "meterreadings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skipWebhook",
                  "value": "<boolean>",
                  "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
                }
              ],
              "variable": []
            },
