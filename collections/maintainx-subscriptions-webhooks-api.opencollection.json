{
  "opencollection": "1.0.0",
  "info": {
    "name": "MaintainX Asset Criticalities Subscriptions & Webhooks API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions & Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create new subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getmaintainx.com/v1/subscriptions",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create new subscription"
        },
        {
          "info": {
            "name": "Get subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the subscription"
              }
            ]
          },
          "docs": "Get subscription"
        },
        {
          "info": {
            "name": "Update subscription",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.getmaintainx.com/v1/subscriptions/:id",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the subscription"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update subscription"
        },
        {
          "info": {
            "name": "Remove subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getmaintainx.com/v1/subscriptions/:id",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the subscription"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ]
          },
          "docs": "Remove subscription"
        },
        {
          "info": {
            "name": "Get secret information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/subscriptions/:id/secret",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the subscription"
              }
            ]
          },
          "docs": "Get secret information"
        }
      ]
    }
  ],
  "bundled": true
}