{
  "opencollection": "1.0.0",
  "info": {
    "name": "MaintainX Asset Criticalities Procedure Template Rows API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Procedure Template Rows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update Procedure Template Row",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.getmaintainx.com/v1/proceduretemplaterows/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the procedure template row"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Procedure Template Row"
        },
        {
          "info": {
            "name": "Delete procedure Template Row",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getmaintainx.com/v1/proceduretemplaterows/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the procedure Template Row"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ]
          },
          "docs": "Delete procedure Template Row"
        },
        {
          "info": {
            "name": "Remove procedure template row attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getmaintainx.com/v1/proceduretemplaterows/:id/attachments",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the procedure template row."
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ]
          },
          "docs": "Remove procedure template row attachment"
        },
        {
          "info": {
            "name": "Update procedure template row attachment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getmaintainx.com/v1/proceduretemplaterows/:id/attachments/:filename",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the procedure template row."
              },
              {
                "name": "filename",
                "value": "datasheet.pdf",
                "type": "path",
                "description": "Name of the attachment, including the extension."
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ]
          },
          "docs": "Update procedure template row attachment"
        }
      ]
    }
  ],
  "bundled": true
}