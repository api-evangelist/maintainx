{
  "opencollection": "1.0.0",
  "info": {
    "name": "MaintainX Asset Criticalities Conversations API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List conversations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/conversations",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "onlyNamed",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Endpoint used to list conversation resources"
        },
        {
          "info": {
            "name": "List conversation members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/conversations/:id/members",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List conversation members"
        },
        {
          "info": {
            "name": "Create new message in a conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getmaintainx.com/v1/conversations/:id/messages",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the conversation"
              },
              {
                "name": "skipWebhook",
                "value": "",
                "type": "query",
                "description": "Set `skipWebhook=true`, `skipWebhook=1` or `skipWebhook=yes` to skip all webhooks upon successful operation on the endpoint. [Learn more about webhooks](#tag/Subscriptions-and-Webhooks)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create new message in a conversation"
        }
      ]
    }
  ],
  "bundled": true
}