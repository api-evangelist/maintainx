{
  "opencollection": "1.0.0",
  "info": {
    "name": "MaintainX Asset Criticalities API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Asset Criticalities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List asset criticalities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/assetcriticalities",
            "headers": [
              {
                "name": "x-organization-id",
                "value": "1"
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "label",
                "value": "",
                "type": "query"
              },
              {
                "name": "level",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Endpoint used to list asset criticality resources"
        },
        {
          "info": {
            "name": "Get asset criticality",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmaintainx.com/v1/assetcriticalities/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "ID of the assetCriticality"
              }
            ]
          },
          "docs": "Get asset criticality"
        }
      ]
    }
  ],
  "bundled": true
}